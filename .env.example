# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...            # required to run the assistant
ANTHROPIC_MODEL=claude-sonnet-4-6       # any Claude model with tool use

# --- Assistant <-> mocked bank (service-to-service) ---------------------
BANK_BASE_URL=http://localhost:8001
BANK_SERVICE_KEY=dev-service-key        # must match the mock bank's key

# --- Assistant auth stub -------------------------------------------------
AUTH_SECRET=change-me-in-any-real-deployment
DEMO_AUTH_ENABLED=true                  # exposes POST /auth/demo-login (demo only!)
