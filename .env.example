# Copy this file to .env and fill in ONE provider section. Never commit .env.

# Which model provider to use: "anthropic" or "openai" (any OpenAI-compatible API, e.g. free Groq)
LLM_PROVIDER=anthropic

# --- Option A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Option B: OpenAI-compatible provider (free key at https://console.groq.com) ---
# To use it, set LLM_PROVIDER=openai above and fill in the key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Shared settings (defaults are fine for local use) ---
BANK_SERVICE_KEY=dev-service-key
AUTH_SECRET=change-me-in-any-real-deployment
DEMO_AUTH_ENABLED=true
LOG_FORMAT=text
